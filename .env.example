# ── Runtime (production on ca-serv) ─────────────────────────────────────────
NODE_ENV=production

# ca-serv ports: 3000 canakyuz · 3001 begahome · 3002 wesan · 4100 dante-api · 4101 dante · 5555 api · 9000 begahome-api
PORT=3002

# ── Helm CMS (Supabase) - same project as helm.wesan.co panel ─────────────────
HELM_SUPABASE_URL=
HELM_SUPABASE_ANON_KEY=

# Property slug in Helm (default: wesan)
HELM_PROJECT_SLUG=wesan

# CMS singleton entry slug (default: en)
HELM_ENTRY_SLUG=en

# ISR cache seconds when Helm is configured (default: 60)
HELM_CONTENT_REVALIDATE_SECONDS=60

# Webhook secret - must match Helm → Property → Publish targets → secret
# Generate: openssl rand -hex 32
HELM_REVALIDATE_SECRET=

# Helm publish target (configure in panel, not read by the app):
#   URL:    https://wesan.co/api/revalidate
#   Method: POST
#   Header: x-helm-secret: <HELM_REVALIDATE_SECRET>

# ── Contact form (Resend) ────────────────────────────────────────────────────
# Sending only; incoming mail stays on Google Workspace.
RESEND_API_KEY=
# Optional sender; must be on a domain verified in Resend (default: Wesan <hello@wesan.co>)
MAIL_FROM=
# Origins allowed to post the contact form (default: https://wesan.co,https://www.wesan.co)
ALLOWED_ORIGINS=
# Cloudflare Turnstile. When the secret is set, the form requires a passed challenge.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
